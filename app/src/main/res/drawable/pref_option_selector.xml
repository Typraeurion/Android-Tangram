<?xml version="1.0" encoding="utf-8"?>
<!-- This resource generated by Claude Code (Opus 4.8) -->
<!-- Background for a Preferences option: a rounded accent highlight when
     the option is selected, otherwise a transparent shape of the same
     size so selecting an option does not shift the layout. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#221E90FF" />
            <stroke android:width="2dp" android:color="@color/dodger_blue" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/invisible" />
            <stroke android:width="2dp" android:color="@color/invisible" />
        </shape>
    </item>
</selector>