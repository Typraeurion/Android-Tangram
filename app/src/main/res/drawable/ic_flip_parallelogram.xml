<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ Flip icon: two mirror-image parallelograms (in the theme's
  ~ parallelogram color) with a pair of semicircular swap arrows between
  ~ them.  The geometry is rough and meant to be refined later.
  -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- Left parallelogram -->
    <path
        android:fillColor="?attr/tangramParallelogramColor"
        android:pathData="M 6,18 L 16,8 L 16,28 L 6,38 Z" />
    <!-- Right parallelogram (mirror image) -->
    <path
        android:fillColor="?attr/tangramParallelogramColor"
        android:pathData="M 42,18 L 32,8 L 32,28 L 42,38 Z" />

    <!-- Top swap arrow, curving left-to-right -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="@color/foreground"
        android:strokeWidth="1"
        android:strokeLineCap="round"
        android:pathData="M 19,14 A 7.25,7.25 0 0,1 29,14" />
    <path
        android:fillColor="@color/foreground"
        android:pathData="M 30,15 L 28,15 L 30,13 Z" />

    <!-- Bottom swap arrow, curving right-to-left -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="@color/foreground"
        android:strokeWidth="1"
        android:strokeLineCap="round"
        android:pathData="M 29,26 A 7.25,7.25 0 0,1 19,26" />
    <path
        android:fillColor="@color/foreground"
        android:pathData="M 20,25 L 18,27 L 18,25 Z" />
</vector>
