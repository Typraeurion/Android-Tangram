<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The outline width here MUST be dimensionless; it is used in vector paths. -->
    <attr name="tangramOutlineWidth" format="float|reference" />
    <!-- This should be the equivalent width to use in view contexts. -->
    <attr name="tableOutlineWidth" format="dimension|reference" />
    <attr name="tangramOutlineColor" format="color|reference" />
    <attr name="tangramSmallTriangleColor" format="color|reference" />
    <attr name="tangramSmallSquareColor" format="color|reference" />
    <attr name="tangramParallelogramColor" format="color|reference" />
    <attr name="tangramMediumTriangleColor" format="color|reference" />
    <attr name="tangramLargeTriangleColor" format="color|reference" />

    <!-- Groups the tangram styling attributes so PlayTableView can read
         them from the theme with generated, type-checked index constants. -->
    <declare-styleable name="PlayTableView">
        <attr name="tableOutlineWidth" />
        <attr name="tangramOutlineColor" />
        <attr name="tangramSmallTriangleColor" />
        <attr name="tangramSmallSquareColor" />
        <attr name="tangramParallelogramColor" />
        <attr name="tangramMediumTriangleColor" />
        <attr name="tangramLargeTriangleColor" />
    </declare-styleable>

    <!-- Lets a piece-tray slot declare, in the layout, which kind of piece
         it dispenses and how many are available to start.  The enum values
         are ordered smallest to largest (also rainbow order in the default
         theme) and their order must match PieceTrayItemView.PieceType. -->
    <declare-styleable name="PieceTrayItemView">
        <attr name="pieceType" format="enum">
            <enum name="smallTriangle" value="0" />
            <enum name="square" value="1" />
            <enum name="parallelogram" value="2" />
            <enum name="mediumTriangle" value="3" />
            <enum name="largeTriangle" value="4" />
        </attr>
        <attr name="pieceCount" format="integer" />
    </declare-styleable>
</resources>
