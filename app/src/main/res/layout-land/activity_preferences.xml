<?xml version="1.0" encoding="utf-8"?>
<!-- This layout generated by Claude Code (Opus 4.8) -->
<!-- Landscape variant: each group's label sits to the left of its
     selection icons instead of above them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- UI Theme -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    style="@style/PrefSectionLabelInline"
                    android:text="@string/PrefsTextUITheme" />
                <RadioGroup android:id="@+id/PreferencesRadioGroupUITheme"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:orientation="horizontal">
                    <RadioButton android:id="@+id/PreferencesRadioButtonUILight"
                        style="@style/PrefOptionButton"
                        android:drawableTop="@drawable/pref_ic_light"
                        android:text="@string/PrefsTextThemeLight" />
                    <RadioButton android:id="@+id/PreferencesRadioButtonUIDark"
                        style="@style/PrefOptionButton"
                        android:drawableTop="@drawable/pref_ic_dark"
                        android:text="@string/PrefsTextThemeDark" />
                    <RadioButton android:id="@+id/PreferencesRadioButtonUIDefault"
                        style="@style/PrefOptionButton"
                        android:drawableTop="@drawable/pref_ic_default"
                        android:text="@string/PrefsTextThemeDefault" />
                </RadioGroup>
            </LinearLayout>

            <!-- Piece Coloring -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    style="@style/PrefSectionLabelInline"
                    android:text="@string/PrefsTextPieceTheme" />
                <RadioGroup android:id="@+id/PreferencesRadioGroupPieceTheme"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:orientation="horizontal">
                    <RadioButton android:id="@+id/PreferencesRadioButtonPieceThemeSolid"
                        style="@style/PrefOptionButton"
                        android:drawableTop="@drawable/pref_ic_solid"
                        android:text="@string/PrefsTextPieceThemeSolid" />
                    <RadioButton android:id="@+id/PreferencesRadioButtonPieceThemeOutline"
                        style="@style/PrefOptionButton"
                        android:drawableTop="@drawable/pref_ic_outline"
                        android:text="@string/PrefsTextPieceThemeOutline" />
                    <RadioButton android:id="@+id/PreferencesRadioButtonPieceThemeMulticolor"
                        style="@style/PrefOptionButton"
                        android:drawableTop="@drawable/pref_ic_multicolor"
                        android:text="@string/PrefsTextPieceThemeMulticolor" />
                </RadioGroup>
            </LinearLayout>

            <!-- Hint Level -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    style="@style/PrefSectionLabelInline"
                    android:text="@string/PrefsTextHintLevel" />
                <RadioGroup android:id="@+id/PreferencesRadioGroupHintLevel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:orientation="horizontal">
                    <RadioButton android:id="@+id/PreferencesRadioButtonHintNone"
                        style="@style/PrefOptionButton"
                        android:drawableTop="@drawable/pref_ic_solid"
                        android:text="@string/PrefsTextHintNone" />
                    <RadioButton android:id="@+id/PreferencesRadioButtonHintOutline"
                        style="@style/PrefOptionButton"
                        android:drawableTop="@drawable/pref_ic_outline"
                        android:text="@string/PrefsTextHintOutline" />
                    <RadioButton android:id="@+id/PreferencesRadioButtonHintSolve"
                        style="@style/PrefOptionButton"
                        android:drawableTop="@drawable/pref_ic_multicolor"
                        android:text="@string/PrefsTextHintSolve" />
                </RadioGroup>
            </LinearLayout>

            <!-- Corner Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:layout_weight="1"
                    android:text="@string/PrefsTextCornerButtons" />
                <TableLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="2">
                    <TableRow android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="top|left"
                            android:text="@string/PrefsTextCornerTopLeft"
                            android:textAlignment="gravity" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="top|right"
                            android:text="@string/PrefsTextCornerTopRight"
                            android:textAlignment="gravity" />
                    </TableRow>
                    <TableRow android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <Spinner android:id="@+id/PreferencesSpinnerCornerTopLeft"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:entries="@array/CornerButtonList" />
                        <Spinner android:id="@+id/PreferencesSpinnerCornerTopRight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:entries="@array/CornerButtonList" />
                    </TableRow>
                    <TableRow android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <Spinner android:id="@+id/PreferencesSpinnerCornerBottomLeft"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:entries="@array/CornerButtonList" />
                        <Spinner android:id="@+id/PreferencesSpinnerCornerBottomRight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:entries="@array/CornerButtonList" />
                    </TableRow>
                    <TableRow android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="bottom|left"
                            android:text="@string/PrefsTextCornerBottomLeft"
                            android:textAlignment="gravity" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="bottom|right"
                            android:text="@string/PrefsTextCornerBottomRight"
                            android:textAlignment="gravity" />
                    </TableRow>
                </TableLayout>
            </LinearLayout>

            <!-- Folder for User Puzzles -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/PrefsTextSaveFolder" />
                <Button android:id="@+id/PreferencesButtonSaveFolder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:ellipsize="marquee"
                    android:maxLines="1"
                    android:scrollHorizontally="true"
                    android:text="@string/PrefsTextNoUserDir"
                    android:textAllCaps="false" />
            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <ImageButton android:id="@+id/PreferencesButtonBack"
        android:layout_width="@dimen/hover_control_size"
        android:layout_height="@dimen/hover_control_size"
        android:layout_gravity="center"
        android:layout_margin="@dimen/hover_control_margin"
        android:background="@drawable/hover_button_background"
        android:contentDescription="@string/PlayButtonBackTooltip"
        android:elevation="4dp"
        android:padding="@dimen/hover_control_padding"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_back" />

</LinearLayout>