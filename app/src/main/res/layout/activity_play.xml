<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ This layout generated by Claude Code (Opus 4.8)
  ~ with subsequent tweaks by Trevin Beattie
  ~
  ~ Portrait play screen: the play surface fills the top (with hovering
  ~ controls layered over it) and the tray of available pieces runs along
  ~ the bottom, ordered smallest to largest.
  -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:baselineAligned="false">

    <FrameLayout
        android:id="@+id/play_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.xmission.trevin.android.tangram.ui.PlayTableView
            android:id="@+id/play_table"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Hovering controls.  Back and goal default to opposite top
             corners; their placement is intended to become user-
             customizable (handedness / preference) later. -->
        <LinearLayout
            android:id="@+id/button_back_frame"
            android:layout_width="@dimen/hover_control_size"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="@dimen/hover_control_margin"
            android:orientation="vertical">
            <ImageButton
                android:id="@+id/button_back"
                android:layout_width="@dimen/hover_control_size"
                android:layout_height="@dimen/hover_control_size"
                android:background="@drawable/hover_button_background"
                android:contentDescription="@string/PlayButtonBackTooltip"
                android:elevation="4dp"
                android:padding="@dimen/hover_control_padding"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back"
                android:stateListAnimator="@null"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:padding="@dimen/hover_text_padding"
                android:elevation="5dp"
                android:background="@drawable/hover_text_background"
                android:textColor="@color/foreground"
                android:text="@string/PlayButtonBackText"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/goal_view_frame"
            android:layout_width="@dimen/goal_view_size"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/hover_control_margin"
            android:orientation="vertical">
            <com.xmission.trevin.android.tangram.ui.TangramPuzzleView
                android:id="@+id/goal_view"
                android:layout_width="@dimen/goal_view_size"
                android:layout_height="@dimen/goal_view_size"
                android:padding="@dimen/piece_tray_padding"
                android:contentDescription="@string/PlayViewGoalTooltip"
                android:elevation="4dp"
                android:scaleType="fitCenter" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:padding="@dimen/hover_text_padding"
                android:elevation="5dp"
                android:background="@drawable/hover_text_background"
                android:textColor="@color/foreground"
                android:text="@string/PlayViewGoalText"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/button_save_frame"
            android:layout_width="@dimen/hover_control_size"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/hover_control_margin"
            android:orientation="vertical"
            android:visibility="gone">
            <ImageButton
                android:id="@+id/button_save"
                android:layout_width="@dimen/hover_control_size"
                android:layout_height="@dimen/hover_control_size"
                android:background="@drawable/hover_button_background"
                android:contentDescription="@string/PlayButtonSaveTooltip"
                android:elevation="4dp"
                android:padding="@dimen/hover_control_padding"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_save"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:padding="@dimen/hover_text_padding"
                android:elevation="5dp"
                android:background="@drawable/hover_text_background"
                android:textColor="@color/foreground"
                android:text="@string/PlayButtonSaveText"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/valid_check_frame"
            android:layout_width="@dimen/hover_control_small"
            android:layout_height="@dimen/hover_control_small"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/hover_control_margin"
            android:orientation="vertical"
            android:visibility="gone"
            android:clickable="false"
            android:focusable="false"
            android:descendantFocusability="blocksDescendants">
            <ImageView
                android:id="@+id/valid_check"
                android:layout_width="@dimen/hover_control_small"
                android:layout_height="@dimen/hover_control_small"
                android:background="@drawable/hover_button_background"
                android:contentDescription="@string/ValidTangram"
                android:elevation="4dp"
                android:padding="@dimen/hover_control_padding"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_checkmark_small"/>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/button_flip_frame"
            android:layout_width="@dimen/flip_button_size"
            android:layout_height="@dimen/flip_button_size"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="@dimen/flip_button_margin_bottom"
            android:visibility="gone" >
            <ImageButton
                android:id="@+id/button_flip"
                android:layout_width="@dimen/flip_button_size"
                android:layout_height="@dimen/flip_button_size"
                android:background="@drawable/hover_button_background"
                android:contentDescription="@string/PlayButtonFlipTooltip"
                android:elevation="4dp"
                android:padding="@dimen/hover_control_padding"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_flip_parallelogram" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:padding="@dimen/hover_text_padding"
                android:elevation="5dp"
                android:background="@drawable/hover_text_background"
                android:textColor="@color/foreground"
                android:text="@string/PlayButtonFlipText"
                android:clickable="false"
                android:focusable="false" />
        </FrameLayout>

        <include layout="@layout/valid_tangram_banner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

    </FrameLayout>

    <com.xmission.trevin.android.tangram.ui.PieceTrayLayout
        android:id="@+id/piece_tray"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/piece_tray_padding">

        <com.xmission.trevin.android.tangram.ui.PieceTrayItemView
            android:id="@+id/tray_small_triangle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:pieceType="smallTriangle"
            app:pieceCount="2" />

        <com.xmission.trevin.android.tangram.ui.PieceTrayItemView
            android:id="@+id/tray_square"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:pieceType="square"
            app:pieceCount="1" />

        <com.xmission.trevin.android.tangram.ui.PieceTrayItemView
            android:id="@+id/tray_parallelogram"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:pieceType="parallelogram"
            app:pieceCount="1" />

        <com.xmission.trevin.android.tangram.ui.PieceTrayItemView
            android:id="@+id/tray_medium_triangle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:pieceType="mediumTriangle"
            app:pieceCount="1" />

        <com.xmission.trevin.android.tangram.ui.PieceTrayItemView
            android:id="@+id/tray_large_triangle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:pieceType="largeTriangle"
            app:pieceCount="2" />

    </com.xmission.trevin.android.tangram.ui.PieceTrayLayout>

</LinearLayout>
