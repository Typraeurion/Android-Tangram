<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="1dp">
    <com.xmission.trevin.android.tangram.ui.TangramPuzzleView
        android:id="@+id/ListPuzzleView"
        android:layout_width="@dimen/goal_view_size"
        android:layout_height="@dimen/goal_view_size"
        android:layout_weight="0"
        android:padding="@dimen/piece_tray_padding"
        android:scaleType="fitCenter" />
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="@dimen/goal_view_size"
        android:layout_weight="2"
        android:orientation="vertical"
        android:layout_gravity="center_vertical"
        android:padding="@dimen/piece_tray_padding">
        <TextView android:id="@+id/ListPuzzleName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:layout_weight="2"
            android:ellipsize="end"
            android:gravity="bottom"
            android:maxLines="2"
            android:textStyle="bold" />
        <TextView android:id="@+id/ListPuzzleSource"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|top"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2" />
    </LinearLayout>
    <ImageView android:id="@+id/ListPuzzleDifficultyDot"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="end|center_vertical"
        android:layout_weight="0"
        android:layout_margin="@dimen/piece_tray_padding"
        android:src="@drawable/difficulty_dot_1"
        android:contentDescription="@string/DifficultyDot1Tooltip" />
</LinearLayout>
