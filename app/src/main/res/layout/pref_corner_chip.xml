<?xml version="1.0" encoding="utf-8"?>
<!-- This layout generated by Claude Code (Opus 4.8) -->
<!-- A draggable mock of a play-field hovering control (icon + label),
     used in the Preferences corner-button layout. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:clickable="true"
    android:focusable="true"
    android:longClickable="true">

    <ImageView android:id="@+id/chip_icon"
        android:layout_width="@dimen/hover_control_size"
        android:layout_height="@dimen/hover_control_size"
        android:background="@drawable/hover_button_background"
        android:elevation="4dp"
        android:padding="@dimen/hover_control_padding"
        android:scaleType="fitCenter" />

    <TextView android:id="@+id/chip_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/hover_text_background"
        android:elevation="5dp"
        android:padding="@dimen/hover_text_padding"
        android:textColor="@color/foreground" />

</LinearLayout>