<?xml version="1.0" encoding="utf-8"?>
<!-- This layout generated by Claude Code (Opus 4.8) -->
<!-- A transient, centered "success" banner (checkmark + message) shown
     briefly when the player forms a valid Tangram.  Starts hidden; the
     activity fades it in and out. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/valid_banner"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:elevation="8dp"
    android:background="@drawable/hover_panel_background"
    android:clickable="false"
    android:focusable="false"
    android:visibility="gone">

    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_checkmark_large"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/valid_banner_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:paddingTop="8dp"
        android:textColor="@color/foreground"
        android:textSize="20sp"
        android:textStyle="bold" />

</LinearLayout>